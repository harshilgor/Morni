NEXT_PUBLIC_SUPABASE_URL=https://xobagxgagarnzxujxfag.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_DOMAIN=morniuae.com
NEXT_PUBLIC_SITE_URL=https://www.morniuae.com
# Server-only Gemini API key for AI product drafts
GEMINI_API_KEY=
# Server-only OpenAI key for high-accuracy bulk photo grouping
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.1
# Legacy Vercel AI Gateway key (unused when GEMINI_API_KEY is configured)
AI_GATEWAY_API_KEY=

# Protects cron routes (Authorization: Bearer …)
CRON_SECRET=generate-a-long-random-string

# AFS COPYandPAY (server-only — never NEXT_PUBLIC_*)
# Use UAT credentials with https://eu-test.oppwa.com, or live credentials with https://eu-prod.oppwa.com.
# Never commit credentials; configure the live values only in encrypted environment settings.
AFS_PAYMENTS_ENABLED=false
AFS_BASE_URL=https://eu-test.oppwa.com
AFS_ENTITY_ID=
AFS_ACCESS_TOKEN=
AFS_PAYMENT_BRANDS=VISA MASTER
# 64-char hex secret from AFS Administration → Webhooks (AES-256-GCM)
AFS_WEBHOOK_SECRET=
